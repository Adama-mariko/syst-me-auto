# Configuration d'environnement - TEMPLATE POUR PRODUCTION
# ⚠️ À REMPLIR AVEC VOS VRAIES VALEURS

# Base de données (MySQL, PostgreSQL ou SQLite)
# Format MySQL:  mysql+pymysql://user:password@host:3306/dbname
# Format PostgreSQL:  postgresql://user:password@host:5432/dbname
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/systeme_auto

# Clé secrète (générer une clé cryptographique sécurisée)
# Générer avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_very_secure_secret_key_here_change_this

# Configuration Flask
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# CORS - URLs du frontend autorisées
ALLOWED_ORIGINS=https://systeme-auto-frontend.netlify.app,https://systeme-auto.vercel.app

# API Configuration
API_BASE_URL=https://systeme-auto-backend.onrender.com
FRONTEND_URL=https://systeme-auto-frontend.netlify.app

